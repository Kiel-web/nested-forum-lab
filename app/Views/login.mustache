<h1>Log in</h1>
{{#errors}}
<p class="flash flash-error" role="alert">{{message}}</p>
{{/errors}}
<form method="post" action="{{login_url}}" class="auth-form">
    <input type="hidden" name="_csrf" value="{{csrf}}">
    <label for="identifier">Username or email</label>
    <input id="identifier" name="identifier" type="text" value="{{identifier}}" autocomplete="username" required>
    <label for="password">Password</label>
    <input id="password" name="password" type="password" autocomplete="current-password" required>
    <button type="submit">Log in</button>
</form>
<p>No account? <a href="{{register_url}}">Register</a></p>

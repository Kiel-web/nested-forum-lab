<h1>Register</h1>
{{#errors}}
<p class="flash flash-error" role="alert">{{message}}</p>
{{/errors}}
<form method="post" action="{{register_url}}" class="auth-form">
    <input type="hidden" name="_csrf" value="{{csrf}}">
    <label for="username">Username (3-30 letters, numbers, underscore)</label>
    <input id="username" name="username" type="text" value="{{username}}" autocomplete="username" required>
    <label for="email">Email</label>
    <input id="email" name="email" type="email" value="{{email}}" autocomplete="email" required>
    <label for="password">Password (at least 8 characters)</label>
    <input id="password" name="password" type="password" autocomplete="new-password" required>
    <label for="password_confirm">Confirm password</label>
    <input id="password_confirm" name="password_confirm" type="password" autocomplete="new-password" required>
    <button type="submit">Create account</button>
</form>
<p>Already registered? <a href="{{login_url}}">Log in</a></p>

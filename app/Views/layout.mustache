<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}} - Nested Forum Lab</title>
    <link rel="stylesheet" href="{{css_url}}">
</head>
<body>
<header class="site-header">
    <a class="brand" href="{{home_url}}">Nested Forum Lab</a>
    <nav aria-label="Account">
        {{#logged_in}}
        <span>Signed in as <strong>{{current_user}}</strong></span>
        <form method="post" action="{{logout_url}}" class="inline-form">
            <input type="hidden" name="_csrf" value="{{csrf}}">
            <button type="submit">Log out</button>
        </form>
        {{/logged_in}}
        {{^logged_in}}
        <a href="{{login_url}}">Log in</a>
        <a href="{{register_url}}">Register</a>
        {{/logged_in}}
    </nav>
</header>
<main>
    {{#flash}}
    <p class="flash flash-{{type}}" role="status">{{message}}</p>
    {{/flash}}
    {{{content}}}
</main>
<script src="{{js_url}}" defer></script>
</body>
</html>
